rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque groupe vit sous un code secret long, transmis par le lien.
    // Sans ce code, on ne peut ni lire ni écrire, et la liste des groupes n'est pas consultable.
    match /groups/{code}/{coll}/{doc} {
      allow read, write: if code.size() >= 20 && coll in ['profiles', 'weeks', 'group'];
    }
  }
}
